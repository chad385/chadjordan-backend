{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps OpenNext's generated handler to add `scheduled` — see the
  // file header. Reverting to ".open-next/worker.js" disables the cron and
  // restores stock OpenNext behaviour.
  "main": "worker.ts",
  "name": "digital-home-backend",
  // The CRM engine tick + social publish tick. Was a GitHub Action; GitHub
  // throttles scheduled workflows, which stalls onboarding email.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Keep the workers.dev URL alive; add a custom-domain route here when you
  // claim one, e.g. { "pattern": "backend.yourdomain.com", "custom_domain": true }
  "workers_dev": true,
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "digital-home-backend"
    },
    {
      "binding": "FRONTEND_WORKER",
      "service": "digital-home-frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Social media files (videos + carousel slides). Make the bucket public by
  // attaching a custom domain (e.g. media.yourdomain.com) and set
  // R2_PUBLIC_BASE below to match — Meta ingests by pulling that URL, and R2
  // egress is free.
  "r2_buckets": [
    {
      "binding": "SOCIAL_MEDIA",
      "bucket_name": "social-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret env vars. Secrets (API keys) are set via `wrangler secret put`.
  "vars": {
    "SUPABASE_URL": "https://tarbgdnnkwdwldeivwqi.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_6zDb6zTQdAL_Aif5O25Fxg_Tc-tGpyH",
    "NEXT_PUBLIC_SUPABASE_URL": "https://tarbgdnnkwdwldeivwqi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_6zDb6zTQdAL_Aif5O25Fxg_Tc-tGpyH",
    "DIGITAL_HOME_URL": "https://digital-home-frontend.chad-1a0.workers.dev",
    "NEXT_PUBLIC_DIGITAL_HOME_URL": "https://digital-home-frontend.chad-1a0.workers.dev",
    "R2_PUBLIC_BASE": "https://media.yourdomain.com"
  }
}
