{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps OpenNext's generated handler to add `scheduled` — see the
  // file header. Reverting to ".open-next/worker.js" disables the cron and
  // restores stock OpenNext behaviour.
  "main": "worker.ts",
  "name": "chadjordan-backend",
  // The CRM engine tick + social publish tick. Was a GitHub Action; GitHub
  // throttles scheduled workflows, which stalls onboarding email.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Keep the workers.dev URL alive; add a custom-domain route here when you
  // claim one, e.g. { "pattern": "backend.yourdomain.com", "custom_domain": true }
  "workers_dev": true,
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chadjordan-backend"
    },
    {
      "binding": "FRONTEND_WORKER",
      "service": "chadjordan-frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Public marketing media is required, independently of optional social publishing.
  // Create this member-owned bucket first; see MEDIA.md.
  // SOCIAL_MEDIA is preserved from the existing Home.
  "r2_buckets": [
    { "binding": "PUBLIC_MEDIA", "bucket_name": "chadjordan-public-media" },
    {
      "binding": "SOCIAL_MEDIA",
      "bucket_name": "social-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Non-secret env vars. Secrets (API keys) are set via `wrangler secret put`.
  "vars": {
    "SUPABASE_URL": "https://unlmfpqxjuxdqqifxvxm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_28zqFB6-_3UnbwwRUJwCEQ_pBmzYDhw",
    "NEXT_PUBLIC_SUPABASE_URL": "https://unlmfpqxjuxdqqifxvxm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_28zqFB6-_3UnbwwRUJwCEQ_pBmzYDhw",
    "DIGITAL_HOME_URL": "https://chadjordan-frontend.chad-1a0.workers.dev",
    "NEXT_PUBLIC_DIGITAL_HOME_URL": "https://chadjordan-frontend.chad-1a0.workers.dev",
    "SOCIAL_SCHEDULER_MODE": "native",
    // Pinned so saved article image URLs never depend on which hostname
    // handled the upload (MEDIA.md step 5).
    "PUBLIC_MEDIA_BASE": "https://chadjordan-backend.chad-1a0.workers.dev/media",
    "R2_PUBLIC_BASE": "https://media.chadjordan.studio",
    // Image model for article hero images. Pinned to a dated snapshot so the
    // look can't drift when OpenAI updates the alias.
    "OPENAI_IMAGE_MODEL": "gpt-image-2-2026-04-21"
  }
}
